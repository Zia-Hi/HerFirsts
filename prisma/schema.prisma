generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  email         String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  gameProgress  GameProgress?

  @@map("users")
}

model GameProgress {
  id                String   @id @default(cuid())
  userId            String   @unique
  completedMissions String[] @default([])
  mission2Started   Boolean  @default(false)
  mission4Started   Boolean  @default(false)
  lightingEventShown      Boolean @default(false)
  lightingToolsCollected  Boolean @default(false)
  lightingPrecautionShown Boolean @default(false)
  chapter1LetterPending   Boolean @default(false)
  chapter1LetterShown     Boolean @default(false)
  chapter2LetterPending   Boolean @default(false)
  chapter2LetterShown     Boolean @default(false)
  chapter3LetterPending   Boolean @default(false)
  chapter3LetterShown     Boolean @default(false)
  endingShown            Boolean @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("game_progress")
}
